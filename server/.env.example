# Copy to server/.env and fill in. Never commit .env.

# MongoDB used by the API and by `npm run seed` (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/csqp

# API port
PORT=5000

# MongoDB server for Jest tests. Each Jest worker uses "<name>_<worker>",
# and the name must contain "test" (the test helper wipes it).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/csqp_test

# Password for all seed accounts (default: Password1)
SEED_PASSWORD=Password1

# HTTPS/TLS configuration (production only)
# Set HTTPS_MODE=direct when Node.js serves HTTPS itself.
# Set HTTPS_MODE=proxy when a trusted reverse proxy terminates HTTPS.
# Configure the actual trusted proxy IPs/CIDRs when using proxy mode.
# Leave unset for local development.
HTTPS_MODE=
TRUSTED_PROXY_IPS=
TLS_CERT_PATH=
TLS_KEY_PATH=

# Email Dispatch Configuration (Gmail SMTP)
# Set your Gmail address and 16-character Google App Password.
# If left empty in local development, emails are logged to the console.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Collaborative Quiz Platform"
CLIENT_URL=http://localhost:5173


# Python analytics service (CSQP-27). Start it with:
#   cd analytics && uvicorn app.main:app --port 8001
# The student "My progress" page needs it running.
ANALYTICS_URL=http://localhost:8001
# Must match ANALYTICS_INTERNAL_TOKEN in the analytics service (leave empty locally).
ANALYTICS_INTERNAL_TOKEN=
