# Copy to .env.local and adjust. Vite only exposes variables starting with VITE_.

# Express API base URL (CSQP-1 server runs on port 5000)
VITE_API_URL=http://localhost:5000/api

# true = use the in-browser demo auth instead of the real API (until CSQP-7/8/9 are merged)
VITE_USE_MOCK_AUTH=false

# Required ending for registration emails (CSQP-F-001 / TC-Auth-01)
VITE_COLLEGE_EMAIL_SUFFIX=.edu
